{
  "manifest_version": 3,
  "name": "Student Agenda — RCHS",
  "short_name": "Agenda",
  "version": "1.0.0",
  "description": "Homework, bell schedule, announcements, and the school calendar for Rensselaer Central High School — in your browser's side panel.",
  "icons": {
    "16": "icons/ext-16.png",
    "32": "icons/ext-32.png",
    "48": "icons/ext-48.png",
    "128": "icons/ext-128.png"
  },
  "action": {
    "default_title": "Open Student Agenda",
    "default_icon": {
      "16": "icons/ext-16.png",
      "32": "icons/ext-32.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Open Student Agenda"
    }
  },
  "permissions": ["sidePanel"]
}
